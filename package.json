{
  "name": "free-cross-device-audiobook",
  "version": "0.4.0",
  "private": true,
  "description": "Free cross-device audiobook PWA with a local Mac TTS agent",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:free": "python3 scripts/free-tier-audit/check_forbidden_config.py",
    "audit:secrets": "python3 scripts/secret-scan/scan_repo.py",
    "build": "npm run build --workspace @audiobook/web",
    "dev": "npm run dev --workspace @audiobook/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:python": "bash scripts/test-python.sh",
    "test:e2e": "npm run test:e2e --workspace @audiobook/web",
    "test:rules": "bash scripts/firebase-emulator-test.sh",
    "test:web": "npm run test --workspace @audiobook/web",
    "test": "npm run audit:free && npm run audit:secrets && npm run typecheck && npm run test:web && npm run test:rules && npm run test:python"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "firebase-tools": "15.24.0"
  }
}
