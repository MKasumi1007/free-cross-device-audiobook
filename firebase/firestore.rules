rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid;
    }

    function requestKeepsOwner(ownerUid) {
      return request.resource.data.owner_uid == ownerUid;
    }

    function hasRecentPairingAttempt(pairingHash) {
      let attemptPath = /databases/$(database)/documents/pairingAttempts/$(request.auth.uid);
      return signedIn()
        && exists(attemptPath)
        && get(attemptPath).data.owner_uid == request.auth.uid
        && get(attemptPath).data.last_pairing_hash == pairingHash
        && get(attemptPath).data.attempt_count >= 1
        && get(attemptPath).data.attempt_count <= 5
        && get(attemptPath).data.updated_at >= request.time - duration.value(1, 'm');
    }

    function activeWorkerFor(ownerUid) {
      let linkPath = /databases/$(database)/documents/workerLinks/$(request.auth.uid);
      return signedIn()
        && exists(linkPath)
        && get(linkPath).data.owner_uid == ownerUid
        && get(linkPath).data.revoked_at == null
        && get(linkPath).data.scopes.hasAll(['generation']);
    }

    function activeTaskLease(ownerUid, taskId) {
      let taskPath = /databases/$(database)/documents/users/$(ownerUid)/generationRequests/$(taskId);
      return exists(taskPath)
        && get(taskPath).data.owner_uid == ownerUid
        && get(taskPath).data.task_id == taskId
        && get(taskPath).data.status == 'UPLOADING'
        && get(taskPath).data.attempt_id == request.resource.data.attempt_id
        && get(taskPath).data.lease_owner == request.auth.uid
        && get(taskPath).data.lease_token == request.resource.data.lease_token
        && get(taskPath).data.lease_deadline > request.time
        && get(taskPath).data.deletion_generation == request.resource.data.deletion_generation;
    }

    function deletionRequestAfter(ownerUid, requestId) {
      return getAfter(
        /databases/$(database)/documents/users/$(ownerUid)/audioDeletionRequests/$(requestId)
      );
    }

    function deletionTaskAfter(ownerUid, taskId) {
      return getAfter(
        /databases/$(database)/documents/users/$(ownerUid)/generationRequests/$(taskId)
      );
    }

    function ownerUpdateOnly(ownerUid, fields) {
      return isOwner(ownerUid)
        && requestKeepsOwner(ownerUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function validPairingLink(workerUid) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'worker_uid', 'owner_uid', 'worker_type', 'scopes', 'pairing_hash',
          'revoked_at', 'created_at', 'updated_at', 'last_seen_at'
        ])
        && request.resource.data.worker_uid == workerUid
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.worker_type == 'MAC_AGENT'
        && request.resource.data.scopes.hasOnly(['generation'])
        && request.resource.data.revoked_at == null
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time
        && request.resource.data.last_seen_at == null
        && getAfter(/databases/$(database)/documents/pairingRequests/$(request.resource.data.pairing_hash)).data.worker_uid == workerUid
        && getAfter(/databases/$(database)/documents/pairingRequests/$(request.resource.data.pairing_hash)).data.owner_uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/pairingRequests/$(request.resource.data.pairing_hash)).data.used_at == request.time
        && hasRecentPairingAttempt(request.resource.data.pairing_hash);
    }

    function validWorkerTransition() {
      return (resource.data.status == 'QUEUED' && request.resource.data.status == 'LEASED')
        || (resource.data.status == 'FAILED_RETRYABLE' && request.resource.data.status == 'LEASED')
        || (
          resource.data.status == 'PAUSED'
          && resource.data.pause_reason in ['WAITING_FOR_AC_POWER', 'MEMORY_PRESSURE', 'WAITING_FOR_MAC']
          && request.resource.data.status == 'LEASED'
        )
        || (
          resource.data.status in ['LEASED', 'GENERATING', 'ENCODING', 'UPLOADING']
          && resource.data.lease_deadline <= request.time
          && request.resource.data.status == 'LEASED'
        )
        || (resource.data.status == 'LEASED' && request.resource.data.status in ['LEASED', 'GENERATING', 'PAUSED', 'FAILED_RETRYABLE'])
        || (resource.data.status == 'GENERATING' && request.resource.data.status in ['GENERATING', 'ENCODING', 'PAUSED', 'FAILED_RETRYABLE'])
        || (resource.data.status == 'ENCODING' && request.resource.data.status in ['ENCODING', 'UPLOADING', 'PAUSED', 'FAILED_RETRYABLE'])
        || (resource.data.status == 'UPLOADING' && request.resource.data.status in ['UPLOADING', 'READY', 'PAUSED', 'FAILED_RETRYABLE']);
    }

    function validWorkerLease() {
      let isClaim = request.resource.data.status == 'LEASED'
        && (
          resource.data.status in ['QUEUED', 'FAILED_RETRYABLE']
          || (
            resource.data.status == 'PAUSED'
            && resource.data.pause_reason in ['WAITING_FOR_AC_POWER', 'MEMORY_PRESSURE', 'WAITING_FOR_MAC']
          )
          || (
            resource.data.status in ['LEASED', 'GENERATING', 'ENCODING', 'UPLOADING']
            && resource.data.lease_deadline <= request.time
          )
        );
      return (
          isClaim
          && request.resource.data.attempt_id == resource.data.attempt_id + 1
          && request.resource.data.lease_owner == request.auth.uid
          && request.resource.data.lease_token is string
          && request.resource.data.lease_token.size() >= 24
          && request.resource.data.lease_deadline > request.time
          && request.resource.data.pause_reason == null
        ) || (
          !isClaim
          && request.resource.data.attempt_id == resource.data.attempt_id
          && request.resource.data.lease_owner == resource.data.lease_owner
          && request.resource.data.lease_owner == request.auth.uid
          && request.resource.data.lease_token == resource.data.lease_token
          && resource.data.lease_deadline > request.time
        );
    }

    match /users/{ownerUid} {
      allow read: if isOwner(ownerUid);
      allow create: if isOwner(ownerUid) && requestKeepsOwner(ownerUid);
      allow update: if ownerUpdateOnly(ownerUid, ['display_name', 'photo_url', 'updated_at']);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read: if isOwner(ownerUid);
        allow create: if isOwner(ownerUid)
          && requestKeepsOwner(ownerUid)
          && request.resource.data.device_id == deviceId;
        allow update: if ownerUpdateOnly(ownerUid, [
          'name', 'platform', 'last_seen_at', 'updated_at', 'push_capability'
        ]) && request.resource.data.device_id == deviceId;
        allow delete: if isOwner(ownerUid);
      }

      match /books/{bookId} {
        allow read: if isOwner(ownerUid);
        allow create: if isOwner(ownerUid)
          && requestKeepsOwner(ownerUid)
          && request.resource.data.book_id == bookId;
        allow update: if (
          isOwner(ownerUid)
          && requestKeepsOwner(ownerUid)
          && request.resource.data.book_id == bookId
          && request.resource.data.source_sha256 == resource.data.source_sha256
        ) || (
          activeWorkerFor(ownerUid)
          && requestKeepsOwner(ownerUid)
          && resource.data.publication_mode == 'PUBLIC_RIGHTS_CONFIRMED'
          && request.resource.data.book_id == resource.data.book_id
          && request.resource.data.source_sha256 == resource.data.source_sha256
          && request.resource.data.text_status == 'READY'
          && request.resource.data.text_asset_id is int
          && request.resource.data.text_asset_url is string
          && request.resource.data.text_sha256 is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text_status', 'text_asset_id', 'text_asset_name', 'text_asset_url',
            'text_sha256', 'text_byte_size', 'text_schema_version', 'updated_at'
          ])
        );
        allow delete: if isOwner(ownerUid);

        match /chapters/{chapterId} {
          allow read: if isOwner(ownerUid);
          allow create: if isOwner(ownerUid)
            && requestKeepsOwner(ownerUid)
            && request.resource.data.book_id == bookId
            && request.resource.data.chapter_id == chapterId;
          allow update: if isOwner(ownerUid)
            && requestKeepsOwner(ownerUid)
            && request.resource.data.book_id == bookId
            && request.resource.data.chapter_id == chapterId;
          allow delete: if isOwner(ownerUid);
        }

        match /bookmarks/{bookmarkId} {
          allow read, delete: if isOwner(ownerUid);
          allow create, update: if isOwner(ownerUid) && requestKeepsOwner(ownerUid);
        }

        match /audioChunks/{chunkId} {
          allow read: if isOwner(ownerUid) || activeWorkerFor(ownerUid);
          allow create: if activeWorkerFor(ownerUid)
            && requestKeepsOwner(ownerUid)
            && request.resource.data.book_id == bookId
            && request.resource.data.chunk_id == chunkId
            && request.resource.data.status == 'READY'
            && request.resource.data.task_id is string
            && activeTaskLease(ownerUid, request.resource.data.task_id);
          allow update: if (
            isOwner(ownerUid)
            && requestKeepsOwner(ownerUid)
            && resource.data.status == 'READY'
            && request.resource.data.status == 'FAILED_RETRYABLE'
            && request.resource.data.error_code == 'PLAYBACK_UNAVAILABLE'
            && request.resource.data.deletion_generation == resource.data.deletion_generation + 1
            && request.resource.data.updated_at == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'error_code', 'deletion_generation', 'updated_at'
            ])
          ) || (
            activeWorkerFor(ownerUid)
            && requestKeepsOwner(ownerUid)
            && request.resource.data.task_id == resource.data.task_id
            && request.resource.data.book_id == resource.data.book_id
            && request.resource.data.chunk_id == resource.data.chunk_id
            && resource.data.status == 'FAILED_RETRYABLE'
            && request.resource.data.status == 'READY'
            && request.resource.data.deletion_generation == resource.data.deletion_generation
            && activeTaskLease(ownerUid, request.resource.data.task_id)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'attempt_id', 'lease_token', 'start_segment_id', 'end_segment_id',
              'chapter_id', 'duration_seconds', 'asset_id', 'asset_url', 'sha256',
              'byte_size', 'codec', 'timeline_asset_id', 'timeline_url',
              'timeline_sha256', 'voice_version', 'error_code', 'updated_at',
              'completed_at'
            ])
          ) || (
            isOwner(ownerUid)
            && requestKeepsOwner(ownerUid)
            && resource.data.status in ['READY', 'FAILED_RETRYABLE']
            && request.resource.data.status == 'DELETING'
            && request.resource.data.deletion_generation == resource.data.deletion_generation + 1
            && request.resource.data.deletion_request_id is string
            && request.resource.data.delete_requested_at == request.time
            && request.resource.data.updated_at == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'deletion_generation', 'deletion_request_id',
              'delete_requested_at', 'updated_at'
            ])
            && deletionRequestAfter(ownerUid, request.resource.data.deletion_request_id).data.owner_uid == ownerUid
            && deletionRequestAfter(ownerUid, request.resource.data.deletion_request_id).data.book_id == bookId
            && deletionRequestAfter(ownerUid, request.resource.data.deletion_request_id).data.chunk_id == chunkId
            && deletionRequestAfter(ownerUid, request.resource.data.deletion_request_id).data.task_id == resource.data.task_id
            && deletionRequestAfter(ownerUid, request.resource.data.deletion_request_id).data.status == 'QUEUED'
            && deletionRequestAfter(ownerUid, request.resource.data.deletion_request_id).data.deletion_generation == request.resource.data.deletion_generation
          ) || (
            activeWorkerFor(ownerUid)
            && requestKeepsOwner(ownerUid)
            && resource.data.status == 'DELETING'
            && request.resource.data.status == 'DELETED'
            && request.resource.data.task_id == resource.data.task_id
            && request.resource.data.book_id == resource.data.book_id
            && request.resource.data.chunk_id == resource.data.chunk_id
            && request.resource.data.deletion_generation == resource.data.deletion_generation
            && request.resource.data.asset_id == null
            && request.resource.data.asset_url == null
            && request.resource.data.timeline_asset_id == null
            && request.resource.data.timeline_url == null
            && request.resource.data.deleted_at == request.time
            && request.resource.data.updated_at == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'asset_id', 'asset_url', 'timeline_asset_id',
              'timeline_url', 'deleted_at', 'updated_at'
            ])
            && deletionRequestAfter(ownerUid, resource.data.deletion_request_id).data.status == 'DONE'
            && deletionRequestAfter(ownerUid, resource.data.deletion_request_id).data.lease_owner == request.auth.uid
            && deletionRequestAfter(ownerUid, resource.data.deletion_request_id).data.deletion_generation == resource.data.deletion_generation
          ) || (
            isOwner(ownerUid)
            && requestKeepsOwner(ownerUid)
            && resource.data.status == 'DELETED'
            && request.resource.data.status == 'FAILED_RETRYABLE'
            && request.resource.data.error_code == 'REGENERATION_REQUESTED'
            && request.resource.data.deletion_generation == resource.data.deletion_generation
            && request.resource.data.updated_at == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'error_code', 'updated_at'
            ])
            && deletionTaskAfter(ownerUid, resource.data.task_id).data.status == 'QUEUED'
            && deletionTaskAfter(ownerUid, resource.data.task_id).data.deletion_generation == resource.data.deletion_generation
            && deletionTaskAfter(ownerUid, resource.data.task_id).data.start_segment_id == resource.data.start_segment_id
          );
          allow delete: if false;
        }
      }

      match /progress/{bookId} {
        allow read: if isOwner(ownerUid);
        allow create: if isOwner(ownerUid)
          && requestKeepsOwner(ownerUid)
          && request.resource.data.book_id == bookId
          && request.resource.data.version == 1;
        allow update: if isOwner(ownerUid)
          && requestKeepsOwner(ownerUid)
          && request.resource.data.book_id == bookId
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.updated_at == request.time;
        allow delete: if isOwner(ownerUid);
      }

      match /generationRequests/{taskId} {
        allow read: if isOwner(ownerUid) || activeWorkerFor(ownerUid);
        allow create: if isOwner(ownerUid)
          && requestKeepsOwner(ownerUid)
          && request.resource.data.task_id == taskId
          && request.resource.data.status in ['QUEUED', 'PAUSED']
          && request.resource.data.attempt_id == 0;
        allow update: if (
          ownerUpdateOnly(ownerUid, [
            'status', 'pause_reason', 'priority', 'deletion_generation',
            'start_segment_id', 'retry_not_before', 'updated_at'
          ]) && request.resource.data.status in ['QUEUED', 'PAUSED', 'CANCELLED']
        ) || (
          activeWorkerFor(ownerUid)
          && requestKeepsOwner(ownerUid)
          && request.resource.data.task_id == taskId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'attempt_id', 'lease_owner', 'lease_token', 'lease_deadline',
              'checkpoint_segment_id', 'checkpoint_order', 'error_code', 'error_message',
              'pause_reason', 'retry_not_before', 'updated_at'
          ])
          && (
            request.resource.data.status != 'PAUSED'
            || request.resource.data.pause_reason in [
              'USER_PAUSED', 'WAITING_FOR_AC_POWER', 'MEMORY_PRESSURE',
              'WAITING_FOR_MAC', 'VOICE_VERSION_CHANGED'
            ]
          )
          && validWorkerTransition()
          && validWorkerLease()
        );
        allow delete: if false;
      }

      match /audioDeletionRequests/{requestId} {
        allow read: if isOwner(ownerUid) || activeWorkerFor(ownerUid);
        allow create: if isOwner(ownerUid)
          && requestKeepsOwner(ownerUid)
          && request.resource.data.request_id == requestId
          && request.resource.data.status == 'QUEUED'
          && request.resource.data.attempt_count == 0
          && request.resource.data.created_at == request.time
          && request.resource.data.updated_at == request.time
          && getAfter(
            /databases/$(database)/documents/users/$(ownerUid)/books/$(request.resource.data.book_id)/audioChunks/$(request.resource.data.chunk_id)
          ).data.status == 'DELETING'
          && getAfter(
            /databases/$(database)/documents/users/$(ownerUid)/books/$(request.resource.data.book_id)/audioChunks/$(request.resource.data.chunk_id)
          ).data.deletion_request_id == requestId
          && getAfter(
            /databases/$(database)/documents/users/$(ownerUid)/books/$(request.resource.data.book_id)/audioChunks/$(request.resource.data.chunk_id)
          ).data.deletion_generation == request.resource.data.deletion_generation;
        allow update: if activeWorkerFor(ownerUid)
          && requestKeepsOwner(ownerUid)
          && request.resource.data.request_id == requestId
          && request.resource.data.book_id == resource.data.book_id
          && request.resource.data.chunk_id == resource.data.chunk_id
          && request.resource.data.task_id == resource.data.task_id
          && request.resource.data.deletion_generation == resource.data.deletion_generation
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'attempt_count', 'lease_owner', 'lease_token', 'lease_deadline',
            'retry_not_before', 'error_code', 'error_message', 'updated_at', 'completed_at'
          ])
          && (
            (
              resource.data.status in ['QUEUED', 'FAILED_RETRYABLE']
              && request.resource.data.status == 'PROCESSING'
              && request.resource.data.attempt_count == resource.data.attempt_count + 1
              && request.resource.data.lease_owner == request.auth.uid
              && request.resource.data.lease_token is string
              && request.resource.data.lease_token.size() >= 24
              && request.resource.data.lease_deadline > request.time
            ) || (
              resource.data.status == 'PROCESSING'
              && resource.data.lease_deadline <= request.time
              && request.resource.data.status == 'PROCESSING'
              && request.resource.data.attempt_count == resource.data.attempt_count + 1
              && request.resource.data.lease_owner == request.auth.uid
              && request.resource.data.lease_token is string
              && request.resource.data.lease_token.size() >= 24
              && request.resource.data.lease_deadline > request.time
            ) || (
              resource.data.status == 'PROCESSING'
              && resource.data.lease_owner == request.auth.uid
              && resource.data.lease_token == request.resource.data.lease_token
              && resource.data.lease_deadline > request.time
              && request.resource.data.status in ['FAILED_RETRYABLE', 'DONE']
              && request.resource.data.attempt_count == resource.data.attempt_count
              && (
                request.resource.data.status != 'DONE'
                || (
                  request.resource.data.completed_at == request.time
                  && getAfter(
                    /databases/$(database)/documents/users/$(ownerUid)/books/$(resource.data.book_id)/audioChunks/$(resource.data.chunk_id)
                  ).data.status == 'DELETED'
                )
              )
            )
          );
        allow delete: if false;
      }

      match /maintenance/{documentId} {
        allow read: if isOwner(ownerUid);
        allow create: if activeWorkerFor(ownerUid)
          && requestKeepsOwner(ownerUid)
          && request.resource.data.updated_at == request.time
          && request.resource.data.keys().hasOnly([
            'owner_uid', 'kind', 'missing_assets', 'damaged_assets',
            'orphan_assets', 'checked_books', 'summary', 'updated_at'
          ]);
        allow update: if activeWorkerFor(ownerUid)
          && requestKeepsOwner(ownerUid)
          && request.resource.data.updated_at == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'owner_uid', 'kind', 'missing_assets', 'damaged_assets',
            'orphan_assets', 'checked_books', 'summary', 'updated_at'
          ]);
        allow delete: if false;
      }
    }

    match /pairingAttempts/{ownerUid} {
      allow read: if isOwner(ownerUid);
      allow create: if isOwner(ownerUid)
        && request.resource.data.owner_uid == ownerUid
        && request.resource.data.attempt_count == 1
        && request.resource.data.last_pairing_hash is string
        && request.resource.data.last_pairing_hash.size() == 64
        && request.resource.data.updated_at == request.time;
      allow update: if isOwner(ownerUid)
        && request.resource.data.owner_uid == ownerUid
        && (
          (
            request.resource.data.attempt_count == resource.data.attempt_count + 1
            && request.resource.data.attempt_count <= 5
          ) || (
            resource.data.updated_at <= request.time - duration.value(10, 'm')
            && request.resource.data.attempt_count == 1
          )
        )
        && request.resource.data.last_pairing_hash is string
        && request.resource.data.last_pairing_hash.size() == 64
        && request.resource.data.updated_at == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'attempt_count', 'updated_at', 'last_pairing_hash'
        ]);
      allow delete: if false;
    }

    match /pairingRequests/{pairingHash} {
      allow create: if signedIn()
        && pairingHash == request.resource.data.code_hash
        && request.resource.data.worker_uid == request.auth.uid
        && request.resource.data.owner_uid == null
        && request.resource.data.used_at == null
        && request.resource.data.attempt_count == 0
        && request.resource.data.created_at == request.time
        && request.resource.data.expires_at > request.time
        && request.resource.data.expires_at <= request.time + duration.value(10, 'm');
      allow get: if hasRecentPairingAttempt(pairingHash)
        && resource.data.expires_at > request.time
        && resource.data.used_at == null
        && resource.data.attempt_count < 5;
      allow list: if false;
      allow update: if hasRecentPairingAttempt(pairingHash)
        && resource.data.owner_uid == null
        && resource.data.used_at == null
        && resource.data.expires_at > request.time
        && request.resource.data.code_hash == resource.data.code_hash
        && request.resource.data.worker_uid == resource.data.worker_uid
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.expires_at == resource.data.expires_at
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.used_at == request.time
        && request.resource.data.attempt_count == resource.data.attempt_count + 1
        && request.resource.data.attempt_count <= 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'owner_uid', 'used_at', 'attempt_count'
        ]);
      allow delete: if signedIn() && resource.data.worker_uid == request.auth.uid;
    }

    match /workerLinks/{workerUid} {
      allow get: if signedIn()
        && (request.auth.uid == workerUid || resource.data.owner_uid == request.auth.uid);
      allow list: if signedIn() && resource.data.owner_uid == request.auth.uid;
      allow create: if validPairingLink(workerUid);
      allow update: if (
        resource.data.owner_uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked_at', 'updated_at'])
        && request.resource.data.revoked_at == request.time
        && request.resource.data.updated_at == request.time
      ) || (
        resource.data.owner_uid == request.auth.uid
        && resource.data.revoked_at != null
        && validPairingLink(workerUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pairing_hash', 'revoked_at', 'created_at', 'updated_at', 'last_seen_at'
        ])
      ) || (
        request.auth.uid == workerUid
        && resource.data.revoked_at == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_seen_at'])
        && request.resource.data.last_seen_at == request.time
      );
      allow delete: if false;
    }
  }
}
